/*
  2  * Práctica de JavaCC — Procesadores de Lenguajes 2026-27
  3  * Mini-REXX: traductor a la máquina de pila abstracta.
  4  *
  5  * Compilación:  javacc Minirexx.jj && javac *.java
  6  * Uso:          java Minirexx [fichero.rexx]   (sin argumento lee de stdin)
  7  *
  8  * El código se emite directamente en el orden en que se reconoce la entrada;
  9  * no se usan variables auxiliares en el código intermedio, solo etiquetas.
 10  */ 
 options {
     STATIC      = false;
     IGNORE_CASE = true;     // palabras reservadas e identificadores sin distinción de mayúsculas
 }
 
 PARSER_BEGIN(Minirexx)
 
 import java.io.*;
  
 public class Minirexx {
 
 /** Contador para generar etiquetas únicas LBL0, LBL1, ... */
     private int numEtiqueta = 0;
     private String nuevaEtiqueta() {
           return "LBL" + (numEtiqueta++);
     }
  
      /** Emite una instrucción de la máquina de pila. */
     private void emite(String instr) {
 	    System.out.println("\t" + instr);
     }
  
      /** Emite la definición de una etiqueta. */
      private void etiqueta(String lbl) {
         System.out.println(lbl + ":");
      }
  
      /** Los identificadores no distinguen mayúsculas: se normalizan a minúsculas. */
      private static String var(Token t) {
          return t.image.toLowerCase();
      }
  
      public static void main(String[] args) {
          try {
              InputStream in = (args.length == 0) ? System.in : new FileInputStream(args[0]);
              Minirexx parser = new Minirexx(in, "UTF-8");
              parser.programa();
          } catch (FileNotFoundException e) {
              System.err.println("Error: no se encuentra el fichero " + args[0]);
              System.exit(1);
          } catch (ParseException e) {
              System.err.println("Error sintactico: " + e.getMessage());
                System.exit(1);
          } catch (TokenMgrError e) {
              System.err.println("Error lexico: " + e.getMessage());
              System.exit(1);
          }
      }
 }
 
 PARSER_END(Minirexx)
/* Analixis Lexico */

// Espacios, tabuladores, salto de lineas y ;

SKIP: { " " | "\t" | "\n" | "\r" | "\f" | ";" }

// comentarios multilinea

MORE : { "/*" : EN_COMENTARIOS}
<EN_COMENTARIOS> SKIP : { "*/" : DEFAULT}
<EN_COMENTARIOS> MORE : { < ~[] >}

// palabras reservadas

TOKEN :{

	< PULL : "pull" > | <SAY : "say"> 
	| < IF : "if" > | < THEN : "then">
	| < ELSE : "else" > | < DO  : "do" >
	| < END : "end" > | < WHILE : "while" >
	| < UNTIL : "until"> | < TO : "to">
        | < BY : "by" >
	| < SELECT : "select" > | < WHEN : "when" >
	| < OTHERWISE : "otherwise" > | < CHOOSE : "choose">
	| < ADDING : "adding" > | < SUBTRACTING : "subtracting" >
}

// operadores y signos de puntuacion

TOKEN : { 
	< ASIG_IGUAL: "=" > | < DISTINTO: "<>"> 
	| < MENOR: "<" > | < MAYOR: ">" > 
	| < MENOR_IGUAL: "<=" > | < MAYOR_IGUAL: ">=">
	| < MAS: "+" > | < MENOS: "-">
	| < POR: "*" > | < DIVISION: "/">
	| < PARENTESIS_ABIERTO: "(" > | < PARENTESIS_CIERRE: ")" >
	| < COMA: "," >
}


// identificadores,numeros y cadenas

TOKEN : {
	< ID: ( <LETRA> | "_" ) ( <LETRA> | <DIGITO> | "_")* >
	| < NUM: (<DIGITO>)+ >
	| < CADENA: "\"" ( ~["\"" , "\n", "\r"] )* "\"" | "'" ( ~["'", "\n", "\r"] )* "'" >
	| < #LETRA: ["a"-"z", "A"-"Z"] >
	| < #DIGITO: ["1"-"9"] > 
}

/* Analisis sintactico y Traduccion */
void programa() : {}
{
	sentencias() <EOF>
}

void sentencias() : {}
{
	( sentencia() )*
}

void sentencia(): {}
{
	asignacion()
	| entrada()
	| salida()
	| condicional()
	| seleccion()
	| bucle()
}

void asignacion(): {Token id;}
{
	id = <ID> "=" { emite( "valori " + var(id));
}
	expresion()	{emite("asigna");}
}

void entrada(): {Token id;}
{
	<PULL> id = <ID> { emite ( "lee " + var(id));}
}

void salida(): {int n = 1;}
{
	<SAY> elementoSalida() ("," elementoSalida() { n ++
;})*	{ emite ("print " + n);}
}

void elementoSalida(): {Token c;}
{
	c = <CADENA> 	{emite ("metecad " + c.image);}
	| expresion()
}

void bloque(): {}
{
	<DO> sentencias() <END>
}
//Condicional del If mas condicion y consecuencia then bloque y Else bloque
void condicional(): { String lblElse = nuevaEtiqueta(), lblFin;}
{
 <IF> condicion() <THEN>   { emite("sifalsovea " + lblElse); }
     bloque()
     (
         <ELSE>                { lblFin = nuevaEtiqueta( );                                
				 emite("vea " + lblFin);
                                 etiqueta(lblElse); }
         bloque()              { etiqueta(lblFin); }
     |
         /* sin ELSE */        { etiqueta(lblElse); }
     )
 }

void seleccion(): { String lblFin = nuevaEtiqueta();}
{
	<SELECT>
	(clausulaWhen(lblFin) )+
	[ <OTHERWISE> bloque() ] 
	<END> 		{etiqueta(lblFin);}
}

void clausulaWhen(String lblFin): { String lblSig = nuevaEtiqueta();}
{ 
	<WHEN> condicion() <THEN> { emite ("sifalsovea " + lblSig);}
	bloque() 	{emite("vea" + lblFin); etiqueta(lblSig);}
}
// Como los tres bucles comienzan por Do hago una funcion en comun
void bucle(): {}
{
	<DO> ( bucleWhile() | bucleUntil() | bucleContador() )
}
// Do while mas la condicion sentencia y END
void bucleWhile(): {String lblIni= nuevaEtiqueta(), lblFin = nuevaEtiqueta();}
{
	<WHILE> 	{ etiqueta(lblIni);}
	condicion()	{ emite("sifalsovea " + lblFin);}
	sentencias() <END>	{emite("vea " + lblIni);
					etiqueta(lblFin);}
}
//Do until condicion sentencias END
// La condicion se emite antes que el cuerpo, se entra saltando directamente al cuerpo y se vuelve a la condicion alfinal
void bucleUntil(): {String lblCond = nuevaEtiqueta(), lblCuerpo = nuevaEtiqueta(), lblFin = nuevaEtiqueta();}
{
	<UNTIL> 	{ emite("vea " + lblCuerpo);
			 etiqueta(lblCuerpo);}
	condicion()	{emite("siciertovea " + lblFin);
			etiqueta(lblCuerpo);}
	sentencia() <END>	{emite("vea " + lblCond);
			etiqueta(lblFin);}
}
// El limite se reevalua antes de cada iteracion, se ejecuta el cuerpo mientras el contador sea menor o igual al limite.
void bucleContador() : { Token id, paso;
                         String v, operacion = "add";
                         String lblIni = nuevaEtiqueta(    ), lblFin = nuevaEtiqueta(); }
{
     id = <ID> "="             { v = var(id);
                                 emite("valori " + v); }
     expresion()               { emite("asigna ");
                                 etiqueta(lblIni);
                                 emite("valord " + v); }
     <TO> expresion()          { emite("esmayor ");
                                emite("siciertovea " +     lblFin); }
    (
       <BY> [ <ADDING> | <SUBTRACTING> { operacion = " sub"; } ]
        paso = <NUM>          { if (Integer.parseInt(paso.image) == 0) {
                                    System.err.println("Error semantico (linea "
                                        + paso.beginLine + ", columna " + paso.beginColumn
                                        + "): el valor de BY debe ser distinto de cero");
                                     System.exit(1);
                              } }
    |
        /* sin BY */          { paso = null; }
    )
    sentencias() <END>        { emite("valori " + v);
                                emite("valord " + v);
                                emite("mete " + (paso == null ? "1" : paso.image));
                                 emite(operacion);
                                 emite("asigna");
                                 emite("vea " + lblIni);
                                 etiqueta(lblFin); }
}

/* Condiciones */


void condicion(): {String op;}
{
	expresion() [ op = relacional() expresion() { emite (op);} ]
}
// Devuelve la secuencia de instrucciones que implementa cada comparacion
String relacional(): {}
{
	"=" { return "esigual";}
	| "<>" { return "esigual\n\tnot";}
	| "<"	{ return "esmenor"; } 
	| ">"	{ return "esmayor";}
	| "<="	{ return " esmayor\n\tnot";}
	| ">="	{ return "esmenor\n\tnot";}
}

/* Expresiones*/

void expresion(): {}
{
	termino() ( "+" termino()	{ emite("add");}
		   | "-" termino()	{emite("sub");})*
}

void termino(): {}
{
	factor() ( "*" factor()		{emite("mul");}
		| "/" factor()	{emite("div");})*
}
// El menos unario se traduce como 0 - atomo
void factor(): {}
{
	"-"	{emite("mete 0");} atomo()	{emite("sub");}
	| "+"	atomo()
	| atomo()
}

void atomo(): {Token t;}
{
	t = <NUM>	{emite("mete " + t.image);}
	| t = <ID>	{emite("valord " + var(t));}
	| "(" expresion() ")"
	| elegir()
}
// CHOOSE es la condicion, e1,e2 y solo se evalua la rama elegida
void elegir(): { String lblFalso = nuevaEtiqueta(),lblFin= nuevaEtiqueta();}
{
	<CHOOSE> "(" condicion() ","	{emite("sifalsovea " + lblFalso);}
	expresion() ","	{emite("vea " + lblFin);
			etiqueta(lblFalso);}
	expresion() ")"	{etiqueta(lblFin);}
}

